rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection:
    // Anyone can view products on the public website
    allow read: if true;
    // Only logged-in admin can add, edit, or delete products
    allow write: if request.auth != null;

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
